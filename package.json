{
  "name": "innerus",
  "version": "2.0.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start --dev-client",
    "start:gallery": "EXPO_PUBLIC_INNERUS_START=gallery EXPO_NO_TELEMETRY=1 expo start --dev-client",
    "ios": "EXPO_NO_TELEMETRY=1 expo run:ios",
    "android": "EXPO_NO_TELEMETRY=1 expo run:android",
    "typecheck": "tsc --noEmit",
    "check:dependencies": "expo install --check",
    "check:project": "node scripts/check-project.mjs",
    "test": "jest --runInBand",
    "check": "npm run typecheck && npm run check:project && npm test",
    "export:ios": "EXPO_NO_TELEMETRY=1 expo export --platform ios --output-dir dist/ios",
    "export:android": "EXPO_NO_TELEMETRY=1 expo export --platform android --output-dir dist/android",
    "start:probe": "EXPO_PUBLIC_INNERUS_START=probe EXPO_NO_TELEMETRY=1 expo start --dev-client",
    "verify:ios": "bash scripts/mac/ios-verify.sh",
    "verify:ios:cloudkit": "CLOUDKIT=1 bash scripts/mac/ios-verify.sh",
    "verify:ios:local": "CLOUDKIT=0 bash scripts/mac/ios-verify.sh",
    "build:ios": "EAS_NO_VCS=1 eas build -p ios --profile production",
    "submit:ios": "EAS_NO_VCS=1 eas submit -p ios --latest"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "expo": "58.0.17",
    "expo-asset": "58.0.18",
    "expo-audio": "58.0.10",
    "expo-blur": "58.0.5",
    "expo-dev-client": "58.0.14",
    "expo-file-system": "58.0.10",
    "expo-font": "58.0.9",
    "expo-iap": "6.1.1",
    "expo-local-authentication": "58.0.2",
    "expo-localization": "58.0.5",
    "expo-notifications": "58.1.6",
    "expo-sharing": "58.0.20",
    "expo-splash-screen": "58.0.11",
    "expo-sqlite": "58.0.13",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "expo-doctor": "1.21.5",
    "jest": "30.5.2",
    "jest-expo": "58.0.12",
    "react-test-renderer": "19.3.0",
    "typescript": "6.0.3"
  }
}
